# Copy to .env and fill in. Never commit .env.

# --- Required on a server ---------------------------------------------------
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me

# Hostnames / IPs the site is reached on (comma-separated)
DJANGO_ALLOWED_HOSTS=nms.example.com,10.0.99.20

# PostgreSQL connection. Leave unset to use SQLite (local development only).
DATABASE_URL=postgres://nms:change-me@localhost:5432/nms

# --- Optional -----------------------------------------------------------------
# True only for local development: shows detailed error pages
DJANGO_DEBUG=False

# Once served over HTTPS: secure cookies, redirect HTTP -> HTTPS
DJANGO_SECURE=False
# Full origins allowed to POST forms when behind HTTPS (comma-separated)
DJANGO_CSRF_TRUSTED_ORIGINS=https://nms.example.com
# HSTS in seconds once HTTPS is confirmed working (e.g. 31536000). 0 = off.
DJANGO_HSTS_SECONDS=0

# Time zone for server-side dates (the UI shows times in each viewer's local time)
DJANGO_TIME_ZONE=UTC

# Let anyone who can reach the site create an account. Keep False on a server.
NMS_ALLOW_SIGNUP=False

# Where collectstatic puts CSS/JS for nginx to serve
DJANGO_STATIC_ROOT=/opt/nms/staticfiles

DJANGO_LOG_LEVEL=INFO
